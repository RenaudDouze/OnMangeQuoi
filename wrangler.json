{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onmangequoi",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MEAL_ROOM",
        "class_name": "MealRoom"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "CREATE_LIST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "READ_LIST_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "IMAGE_WRITE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEAL_IMAGES",
      "bucket_name": "onmangequoi-meal-images"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MealRoom"]
    }
  ]
}
